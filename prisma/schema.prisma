generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Categoria {
  BOLOS
  DOCINHOS
  SOBREMESAS
}

enum Especificacao {
  CUPCAKE
  CASEIRO
  VULCAO
  ANIVERSARIO
  GOURMET
  FINOS
  BROWNIES
  TRAVESSA
  PAVES
  PALHA
  POTE
}

model Doce {
  id            Int            @id @default(autoincrement())
  nome          String
  categoria     Categoria
  especificacao Especificacao
  imagemUrl     String
  itensCarrinho ItemCarrinho[]
  criadoEm      DateTime       @default(now())
  disponivel    Boolean        @default(true)
  descricao     String         @default("")
  preco         Float          @default(0)
  destaque      Boolean        @default(false)
}

model Carrinho {
  id        Int            @id @default(autoincrement())
  sessionId String         @unique
  itens     ItemCarrinho[]
  criadoEm  DateTime       @default(now())
}

model ItemCarrinho {
  id            Int      @id @default(autoincrement())
  carrinho      Carrinho @relation(fields: [carrinhoId], references: [id])
  carrinhoId    Int
  doceId        Int
  doce          Doce     @relation(fields: [doceId], references: [id])
  quantidade    Int
  configuracoes Json
}

model Evento {
  id           Int          @id @default(autoincrement())
  titulo       String
  descricao    String?
  dataInicio   DateTime
  dataFim      DateTime?
  imagemUrl    String?
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt
  itens        EventoItem[]
}

model EventoItem {
  id        Int     @id @default(autoincrement())
  eventoId  Int
  nome      String
  descricao String?
  preco     Float?
  imagemUrl String?
  evento    Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
}

model Configuracao {
  id    Int    @id @default(autoincrement())
  chave String @unique
  valor String
}
